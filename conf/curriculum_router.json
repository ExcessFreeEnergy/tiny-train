    {
      "phase": 2,
      "name": "Instruction Alignment & Tool-Calling Fine-Tuning (80/20 Anchor Blend)",
      "dataset": "router-blend",
      "data_dir": "data/RouterBlend",
      "steps": 650,
      "sequence_length": 512,
      "micro_batch_size": 16,
      "grad_accumulation_steps": 32,
      "learning_rate": 0.00002,
      "warmup_steps": 50
    }
  ]
}
